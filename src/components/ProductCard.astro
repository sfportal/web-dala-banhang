---
// Thẻ sản phẩm: giá Flash Sale, tiết kiệm, thanh suất còn lại, nút thêm giỏ (bay vào giỏ)
const { p, delay = 0, light = false } = Astro.props;
const full = p.line === 'qua';
const vnd = (n) => Number(n || 0).toLocaleString('vi-VN') + 'đ';
const flashPct = p.flash && p.flash.quota ? Math.min(100, Math.round((p.flash.sold / p.flash.quota) * 100)) : 0;
const tags = [];
if (p.flash) tags.push(['⚡ Flash', 'red']);
else if (p.badges?.[0]) tags.push([p.badges[0], p.kind === 'trial' ? 'green' : p.line === 'chanhleo' ? 'purple' : '']);
---
<a href={`/san-pham/${p.slug}`} class="card" data-reveal style={`--d:${delay}s`} data-product={p.id}>
  <div class:list={['media', `l-${p.line}`, { full }]}>
    <div class="tags">{tags.map(([t, c]) => <span class:list={['badge', c]}>{t}</span>)}</div>
    {p.save_pct > 0 && <span class="save">−{p.save_pct}%</span>}
    <img src={full ? p.image : p.image.replace('.webp', '-sm.webp')} alt={`${p.name} ${p.subtitle || ''}`} loading="lazy" width="440" height="440" />
  </div>
  <h3>{p.name}</h3>
  <div class="sub">{p.subtitle}</div>
  {p.flash && p.flash.quota > 0 && (
    <Fragment>
      <div class="stock-bar"><i style={`width:${flashPct}%`}></i></div>
      <div class="stock-txt">{p.flash.left <= 15 ? `Chỉ còn ${p.flash.left} suất` : `Đã bán ${p.flash.sold}/${p.flash.quota} suất`}</div>
    </Fragment>
  )}
  <div class="row">
    <div class:list={['price', { red: !!p.flash }]}>{vnd(p.effective_price)}{p.ref_price && <s>{vnd(p.ref_price)}</s>}</div>
    {p.stock > 0
      ? <button class="add" data-add={p.sku} aria-label={`Thêm ${p.name} vào giỏ`} data-img={full ? p.image : p.image.replace('.webp', '-sm.webp')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
      : <span class="badge">Hết hàng</span>}
  </div>
</a>
