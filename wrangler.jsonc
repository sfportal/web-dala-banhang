{
  "name": "dala-shop",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "dala-shop", "database_id": "f0ae287f-6093-4236-9d04-6c7d33e0ed6e", "migrations_dir": "migrations" }
  ],
  "services": [{ "binding": "THUCHI", "service": "sepay-thuchi" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "SITE_URL": "https://dala.vn" }
}
