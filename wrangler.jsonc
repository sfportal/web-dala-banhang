{
  "name": "dala-shop",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "dala-shop", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "SITE_URL": "https://dala.vn" }
}
